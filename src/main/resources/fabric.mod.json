{
  "schemaVersion": 1,
  "id": "superesrmod",
  "version": "${version}",
  "name": "SuperESRMod",
  "description": "DLSS/FSR super-resolution and frame generation. Press G or use ModMenu.",
  "authors": ["SuperESRMod Team"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.superesrmod.SuperESRMod"],
    "modmenu": ["com.superesrmod.integration.ModMenuIntegration"]
  },
  "mixins": ["superesrmod.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "embeddium": "*",
    "iris": "*",
    "modmenu": "*"
  }
}
